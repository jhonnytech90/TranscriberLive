#!/bin/bash
#
# Transcriber Live — pos-instalacao (macOS)
#
# O payload do .pkg ja colocou cada arquivo no lugar. Aqui so ajustamos o que
# o payload nao consegue: quarentena, permissoes e o registro dos Audio Units.
#
# Log: /private/tmp/transcriberlive-install.log
#
LOG="/private/tmp/transcriberlive-install.log"
exec >> "$LOG" 2>&1
echo ""
echo "=== Transcriber Live — instalado em $(date '+%Y-%m-%d %H:%M:%S') ==="

BUNDLES="/Library/Audio/Plug-Ins/VST3/Transcriber Live Receiver.vst3
/Library/Audio/Plug-Ins/VST3/Transcriber Live Display.vst3
/Library/Audio/Plug-Ins/Components/Transcriber Live Receiver.component
/Library/Audio/Plug-Ins/Components/Transcriber Live Display.component
/Applications/Transcriber Live Display.app"

echo "$BUNDLES" | while IFS= read -r B; do
    [ -e "$B" ] || { echo "AVISO: nao instalado: $B"; continue; }
    # sem isso o host recusa carregar plugin baixado da internet
    /usr/bin/xattr -cr "$B" 2>/dev/null
    /bin/chmod -R a+rX "$B" 2>/dev/null

    # O binario precisa de +x EXPLICITO.
    #
    # "a+rX" com X maiusculo so liga o x onde ja existe algum -- se o bit se
    # perdeu por inteiro (e ele se perde: artefato do GitHub e ZIP, e ZIP nao
    # guarda permissao), ele nao restaura nada. Os plugins funcionam mesmo
    # assim, porque o host os carrega como biblioteca; o .app nao abre, e o
    # macOS so diz "O aplicativo nao pode ser aberto".
    #
    # Fica aqui tambem, e nao so no montador, para consertar quem ja instalou
    # a versao quebrada: basta reinstalar por cima.
    if [ -d "$B/Contents/MacOS" ]; then
        /bin/chmod +x "$B/Contents/MacOS/"* 2>/dev/null
        for X in "$B/Contents/MacOS/"*; do
            [ -e "$X" ] && [ ! -x "$X" ] && echo "AVISO: sem permissao de execucao: $X"
        done
    fi
    echo "ok: $B"
done

# modelos: root:admin com escrita do grupo, para qualquer admin acrescentar
# outro ggml-*.bin depois sem precisar de sudo
DADOS="/Library/Application Support/TranscriberLive"
if [ -d "$DADOS" ]; then
    /usr/sbin/chown -R root:admin "$DADOS" 2>/dev/null
    /bin/chmod -R ug+rwX,o+rX "$DADOS" 2>/dev/null
    echo "modelos: $(/bin/ls "$DADOS/models" 2>/dev/null | /usr/bin/tr '\n' ' ')"
fi

# A licenca e gravada na pasta do USUARIO. Uma versao antiga deste instalador
# criava essa pasta como root, e aí o plugin verificava a licenca, tentava
# gravar, falhava calado e voltava a dizer "nenhuma licenca instalada".
# Nao criamos a pasta aqui (o plugin cria, com o dono certo): so consertamos
# se ela ja existir com o dono errado.
# Quem instala e root, entao $HOME aqui e do root. A casa que interessa e a de
# quem esta logado na tela.
U=$(/usr/bin/stat -f%Su /dev/console 2>/dev/null)
CASA=""
if [ -n "$U" ] && [ "$U" != "root" ]; then
    CASA=$(/usr/bin/dscl . -read "/Users/$U" NFSHomeDirectory 2>/dev/null | /usr/bin/awk '{print $2}')
    PASTA="$CASA/Library/Application Support/TranscriberLive"
    if [ -n "$CASA" ] && [ -d "$PASTA" ]; then
        DONO=$(/usr/bin/stat -f%Su "$PASTA" 2>/dev/null)
        [ "$DONO" != "$U" ] && echo "corrigindo dono da pasta do usuario ($DONO -> $U)"
        /usr/sbin/chown -R "$U":staff "$PASTA" 2>/dev/null
        /bin/chmod -R u+rwX "$PASTA" 2>/dev/null
    fi
fi

# ---------------------------------------------------------------------------
# Limpa instalacao antiga na pasta do USUARIO.
#
# Ate a versao de setembro de 2026 este instalador colocava os plugins em
# ~/Library/Audio/Plug-Ins. Agora eles vao para /Library. Quem atualiza fica
# com DUAS copias -- e a do usuario tem prioridade na maioria dos hosts.
# Resultado: instala a versao nova, abre o REAPER (ou Live, ou Logic) e
# continua vendo a antiga, sem erro nenhum na tela. O SuperRack carrega a do
# sistema, entao o mesmo Mac mostra duas versoes diferentes ao mesmo tempo.
# Aconteceu de verdade e levou um tempo para ser entendido.
#
# Isto repete o que o preinstall ja faz, de proposito: e a rede de seguranca
# do bug que ja aconteceu uma vez. Se um dia o preinstall nao rodar, aqui
# ainda pega.
#
# Removemos SO os quatro bundles com nome exato, so dentro de
# ~/Library/Audio/Plug-Ins. Nada de curinga: um instalador que apaga por
# padrao na pasta de alguem e uma ideia ruim.
# ---------------------------------------------------------------------------
if [ -n "$CASA" ] && [ -d "$CASA" ]; then
    ANTIGOS=0
    for REL in "VST3/Transcriber Live Receiver.vst3" \
               "VST3/Transcriber Live Display.vst3" \
               "Components/Transcriber Live Receiver.component" \
               "Components/Transcriber Live Display.component"; do
        VELHO="$CASA/Library/Audio/Plug-Ins/$REL"
        [ -e "$VELHO" ] || continue
        if /bin/rm -rf "$VELHO"; then
            echo "copia antiga removida: $VELHO"
            ANTIGOS=$((ANTIGOS+1))
        else
            echo "AVISO: nao consegui remover a copia antiga: $VELHO"
            echo "AVISO: o host pode continuar carregando a versao velha."
        fi
    done
    [ "$ANTIGOS" -gt 0 ] && echo "$ANTIGOS copia(s) antiga(s) da pasta do usuario removida(s)."
fi

# o AU aparece sem precisar reiniciar o Mac
/usr/bin/killall -9 AudioComponentRegistrar 2>/dev/null

ABERTOS=""
for app in "SuperRack Performer" "SuperRack" REAPER "Live Professor" Logic MainStage "Ableton Live"; do
    /usr/bin/pgrep -x "$app" >/dev/null 2>&1 && ABERTOS="$ABERTOS $app"
done
[ -n "$ABERTOS" ] && echo "AVISO: reinicie estes programas para ver os plugins novos:$ABERTOS"

echo "=== fim ==="
exit 0
